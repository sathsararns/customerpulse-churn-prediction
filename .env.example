# Copy to .env at the repository root. Docker Compose reads this file.
# Local development defaults; use letters, digits and underscores for this password.
POSTGRES_PASSWORD=customerpulse_local
POSTGRES_PORT=5433
API_PORT=8000
FRONTEND_PORT=5173
MLFLOW_PORT=8088
# Optional source revision for container-trained model manifests:
GIT_REVISION=
# Optional Kafka overlay; internal clients use stream-broker:9092.
KAFKA_PORT=9095
# Optional manual Airflow environment, isolated from application history.
AIRFLOW_PORT=8090
AIRFLOW_DB_PASSWORD=airflow_local
AIRFLOW_ADMIN_PASSWORD=customerpulse_local
AIRFLOW_API_SECRET=customerpulse_local_airflow_secret
AIRFLOW_JWT_SECRET=customerpulse_local_airflow_jwt_secret
